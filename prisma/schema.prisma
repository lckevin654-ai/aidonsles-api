generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ACTIONS HUMANITAIRES
// ============================================================
model Action {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  description   String    @db.Text
  type          String
  status        String    @default("PLANIFIEE")
  date          DateTime
  time          String?
  country       String    @db.VarChar(2)
  city          String
  location      String?
  objective     String    @db.Text
  beneficiaries Int       @default(0)
  budget        Decimal   @db.Decimal(12, 2)
  collected     Decimal   @default(0) @db.Decimal(12, 2)
  used          Decimal   @default(0) @db.Decimal(12, 2)
  currency      String    @default("XAF")
  imageUrl      String?
  videoUrl      String?
  lastUpdate    DateTime  @default(now())
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  donations Donation[]

  @@index([status])
  @@index([publishedAt])
  @@map("actions")
}

// ============================================================
// HEALTH CHECK (test technique)
// ============================================================
model HealthCheck {
  id        String   @id @default(cuid())
  status    String
  createdAt DateTime @default(now())

  @@map("health_checks")
}

// ============================================================
// UTILISATEURS
// ============================================================
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  country       String?  @db.VarChar(2)
  role          String   @default("DONOR")
  status        String   @default("ACTIVE")
  emailVerified Boolean  @default(false)

  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions  Session[]
  donations Donation[]

  @@index([email])
  @@map("users")
}

// ============================================================
// SESSIONS (authentification)
// ============================================================
model Session {
  id           String    @id @default(cuid())
  userId       String
  refreshToken String    @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

// ============================================================
// STATISTIQUES D'IMPACT
// ============================================================
model ImpactStats {
  id                String   @id @default(cuid())
  donors            Int      @default(0)
  actionsCompleted  Int      @default(0)
  peopleHelped      Int      @default(0)
  localities        Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@map("impact_stats")
}

// ============================================================
// PROCHAINE ACTION
// ============================================================
model NextAction {
  id            String    @id @default(cuid())
  title         String
  description   String    @db.Text
  image         String?
  date          DateTime
  time          String?
  country       String    @db.VarChar(2)
  city          String
  location      String?
  objective     String    @db.Text
  beneficiaries Int       @default(0)
  budget        Decimal   @db.Decimal(12, 2)
  collected     Decimal   @default(0) @db.Decimal(12, 2)
  currency      String    @default("EUR")
  status        String    @default("PLANIFIEE")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([active])
  @@map("next_actions")
}

// ============================================================
// GALERIE
// ============================================================
model GalleryItem {
  id        String   @id @default(cuid())
  type      String   @default("photo")
  category  String   @default("terrain")
  title     String
  location  String?
  date      DateTime
  url       String
  actionId  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([category])
  @@index([type])
  @@map("gallery_items")
}

// ============================================================
// ACTUALITÉS
// ============================================================
model News {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String   @db.Text
  content     String?  @db.Text
  image       String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
  @@map("news")
}

// ============================================================
// DONS
// ============================================================
model Donation {
  id             String    @id @default(cuid())
  reference      String    @unique
  userId         String?
  actionId       String?
  amount         Decimal   @db.Decimal(12, 2)
  currency       String    @default("XAF")
  method         String
  status         String    @default("PENDING")

  donorFirstName String?
  donorLastName  String?
  donorEmail     String?
  donorPhone     String?
  donorCountry   String?   @db.VarChar(2)
  isAnonymous    Boolean   @default(false)

  message        String?   @db.Text
  idempotencyKey String?   @unique

  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?
  updatedAt      DateTime  @updatedAt

  user   User?   @relation(fields: [userId], references: [id])
  action Action? @relation(fields: [actionId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("donations")
}

// ============================================================
// ORGANISATIONS (partenaires)
// ============================================================
model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?  @db.Text
  type         String   @default("NGO")
  email        String?
  phone        String?
  website      String?
  address      String?
  city         String
  country      String   @db.VarChar(2)
  logoUrl      String?
  verified     Boolean  @default(false)
  status       String   @default("PENDING")
  since        DateTime?
  contactName  String?
  contactEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([country])
  @@map("organizations")
}

// ============================================================
// BÉNÉFICIAIRES
// ============================================================
model Beneficiary {
  id          String   @id @default(cuid())
  orgId       String?
  name        String
  type        String   @default("Famille")
  description String?  @db.Text
  people      Int      @default(0)
  region      String?
  city        String?
  country     String   @db.VarChar(2) @default("CM")
  status      String   @default("VERIFIED")
  photoUrl    String?
  actionId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([orgId])
  @@map("beneficiaries")
}

// ============================================================
// PREUVES (photos, reçus, documents)
// ============================================================
model Evidence {
  id          String   @id @default(cuid())
  actionId    String?
  donationId  String?
  type        String   @default("Photo")
  title       String
  description String?  @db.Text
  fileUrl     String
  thumbnailUrl String?
  mimeType    String?
  size        Int?
  uploadedBy  String?
  status      String   @default("PENDING")
  validatedAt DateTime?
  validatedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([actionId])
  @@index([status])
  @@map("evidences")
}

// ============================================================
// RAPPORTS
// ============================================================
model Report {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  actionId    String?
  summary     String?  @db.Text
  content     String?  @db.Text
  fileUrl     String?
  author      String
  status      String   @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([actionId])
  @@map("reports")
}

// ============================================================
// SIGNALEMENTS (plaintes)
// ============================================================
model Complaint {
  id          String   @id @default(cuid())
  category    String
  subject     String
  description String   @db.Text
  priority    String   @default("MEDIUM")
  status      String   @default("NEW")
  reporterName  String?
  reporterEmail String?
  reporterPhone String?
  assignedTo  String?
  resolution  String?  @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@map("complaints")
}

// ============================================================
// ALERTES FRAUDE
// ============================================================
model FraudAlert {
  id          String   @id @default(cuid())
  type        String
  level       String   @default("MEDIUM")
  reference   String?
  description String?  @db.Text
  status      String   @default("REVIEW")
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([level])
  @@index([status])
  @@map("fraud_alerts")
}

// ============================================================
// REGISTRE PUBLIC (ledger)
// ============================================================
model LedgerEntry {
  id          String   @id @default(cuid())
  donationId  String?
  actionId    String?
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("XAF")
  hash        String   @unique
  previousHash String?
  type        String   @default("DONATION")
  verified    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([donationId])
  @@index([createdAt])
  @@map("ledger_entries")
}

// ============================================================
// MÉDIATHÈQUE
// ============================================================
model MediaItem {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("image")
  url         String
  thumbnailUrl String?
  mimeType    String?
  size        Int?
  width       Int?
  height      Int?
  duration    Int?
  actionId    String?
  uploadedBy  String?
  status      String   @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@map("media_items")
}

// ============================================================
// PAGES CMS
// ============================================================
model CmsPage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String?  @db.Text
  metaTitle   String?
  metaDescription String?
  status      String   @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@map("cms_pages")
}

// ============================================================
// JOURNAL D'AUDIT
// ============================================================
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userEmail   String?
  action      String
  resource    String?
  resourceId  String?
  details     String?  @db.Text
  ipAddress   String?
  userAgent   String?
  result      String   @default("SUCCESS")
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// LOGS DE SÉCURITÉ
// ============================================================
model SecurityLog {
  id          String   @id @default(cuid())
  event       String
  level       String   @default("INFO")
  userId      String?
  userEmail   String?
  ipAddress   String?
  userAgent   String?
  description String?  @db.Text
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([event])
  @@index([level])
  @@index([createdAt])
  @@map("security_logs")
}

// ============================================================
// NOTIFICATIONS
// ============================================================
model Notification {
  id          String   @id @default(cuid())
  userId      String?
  title       String
  message     String?  @db.Text
  type        String   @default("INFO")
  category    String?
  link        String?
  read        Boolean  @default(false)
  readAt      DateTime?
  priority    String   @default("NORMAL")
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// CONFIGURATION DES PAIEMENTS (Orange Money, MTN MoMo, Visa, Stripe...)
// ============================================================
model PaymentConfig {
  id                 String   @id @default(cuid())
  provider           String   @unique
  label              String?
  enabled            Boolean  @default(false)
  mode               String   @default("SANDBOX")

  publicKey          String?
  secretKeyEncrypted String?
  merchantId         String?
  callbackUrl        String?
  returnUrl          String?
  webhookSecret      String?
  metadata           String?  @db.Text

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([enabled])
  @@map("payment_configs")
}

// ============================================================
// RÉSEAUX SOCIAUX (Facebook, LinkedIn, X, Instagram, TikTok, WhatsApp)
// ============================================================
model SocialLink {
  id         String   @id @default(cuid())
  platform   String   @unique
  label      String
  url        String
  icon       String?
  enabled    Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([enabled])
  @@index([order])
  @@map("social_links")
}