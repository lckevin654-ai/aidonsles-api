# APPLICATION
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5500

# BASE DE DONNÉES
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# REDIS
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="your-secret-here-64-chars-minimum"
JWT_REFRESH_SECRET="your-secret-here-64-chars-minimum"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# COOKIES
COOKIE_SECRET="your-secret-here-32-chars-minimum"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"

# ADMIN 2FA
ADMIN_2FA_ISSUER="AIDONS LES Admin"

# PAIEMENT
NOTCHPAY_PUBLIC_KEY=""
NOTCHPAY_SECRET_KEY=""
NOTCHPAY_WEBHOOK_SECRET=""
NOTCHPAY_API_URL="https://api.notchpay.co"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLIC_KEY=""

# STOCKAGE
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# EMAILS
RESEND_API_KEY=""
EMAIL_FROM="AIDONS LES <noreply@aidonsles.org>"

# SÉCURITÉ
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ============================================================
# CLOUDINARY (stockage médias)
# ============================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================================
# CHIFFREMENT DES CLÉS API DE PAIEMENT
# ============================================================
PAYMENT_ENCRYPTION_KEY=change-me-32-characters